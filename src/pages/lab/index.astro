---
// Сравнение трёх концепций мобильного первого экрана рядом (для просмотра с компьютера).
import '../../styles/v9-site.css';
import '../../styles/lab.css';
const base = import.meta.env.BASE_URL;
const items = [
  ['a', 'A · Арка-окно', 'Светлая, ДНК v9. Интерьер в арке на половину экрана, текст — две строки, кнопки-«пилюли». При прокрутке арка приближается, фото внутри движется медленнее.'],
  ['b', 'B · Лента комнат', 'Первый экран — сразу каталог: короткий заголовок и лента арок-комнат, листается пальцем. Первая комната — видео.'],
  ['c', 'C · Вечерняя сцена', 'Полноэкранное видео, вечерний свет и контраст, светлый текст внизу. Первый экран «прилипает», следующий раздел наезжает на него.'],
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Лаборатория первого экрана — VERNISSAGE</title>
</head>
<body>
  <main class="lab-cmp">
    <h1>Три концепции мобильного первого экрана</h1>
    <p>Экспериментальная ветка, не рабочая сборка. Видео — заглушки: движение камеры и свет по реальным фотографиям VERNISSAGE. Каждую концепцию можно открыть отдельно на телефоне.</p>
    <div class="lab-row">
      {items.map(([k, t, d]) => (
        <figure>
          <iframe src={`${base}lab/${k}/`} title={t} loading="lazy"></iframe>
          <figcaption><a href={`${base}lab/${k}/`}>{t}</a><small>{d}</small></figcaption>
        </figure>
      ))}
    </div>
  </main>
</body>
</html>

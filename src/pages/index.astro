---
// ЭКСПЕРИМЕНТ experiment/cinematic — VERNISSAGE Cinematic Redesign 2.0 (главная).
// Направление — Taste Skill (вид: услуга; только реальные фото; моменты word-highlight и pinned-chapters),
// анимации — GSAP ScrollTrigger (r2.ts), микровзаимодействия — по Emil Kowalski. 3D-раздел, заявка и подвал — рабочие компоненты v9.
// Прежние эксперименты: /lab/scroll/ (видео по прокрутке), /lab/ (концепции первого экрана), /lab/arch/.
import '../styles/r2.css';
import V9Site from '../layouts/V9Site.astro';
import R2Hero from '../components/r2/R2Hero.astro';
import R2Statement from '../components/r2/R2Statement.astro';
import R2Rooms from '../components/r2/R2Rooms.astro';
import R2Project from '../components/r2/R2Project.astro';
import R2Business from '../components/r2/R2Business.astro';
import R2Process from '../components/r2/R2Process.astro';
import Kit3D from '../components/v9/Kit3D.astro';
import Lead from '../components/v9/Lead.astro';
import Footer from '../components/v9/Footer.astro';
---
<V9Site
  title="VERNISSAGE — мебель на заказ в Астане по вашим размерам"
  description="Кухни, шкафы, гостиные, спальни и ванные по вашим размерам. Соберите мебель в 3D-конструкторе или отправьте заявку на расчёт — стоимость посчитает менеджер после бесплатного замера."
  path=""
>
  <div class="r2">
    <R2Hero />
    <R2Statement />
    <R2Rooms />
    <R2Project />
    <R2Business />
    <R2Process />
  </div>
  <Kit3D />
  <Lead />
  <Footer />
</V9Site>
<script>
  import '../scripts/r2';
</script>

---
import Ph from './Ph.astro';
import { CONTACTS, waLink } from '../../data/site';
import { createLink, CATEGORY_LINKS } from '../../data/create3d';
const base = import.meta.env.BASE_URL;
const wa = waLink('Здравствуйте! Хочу рассчитать мебель на заказ.');
---
<section class="x-sec k-sec" id="3d" data-anchor="3d" aria-labelledby="h-3d">
    <div class="x-in k-grid" data-k3>
      <div>
        <h2 class="x-h2" id="h-3d">Соберите кухню в 3D</h2>
        <p class="x-lead" style="margin-top:22px">Выберите планировку и отделку — покажем готовый рендер этого сочетания из демо-версии конструктора. Свои размеры и живую 3D-сцену откройте в самом конструкторе.</p>
        <div class="k-ctrl">
          <fieldset><legend>Планировка</legend>
            <div class="k-plan">
              <button type="button" data-lay="straight" aria-pressed="true"><svg viewBox="0 0 64 44" aria-hidden="true"><path class="wl" d="M4 5h56"/><rect class="m" x="6" y="9" width="52" height="11"/></svg> Прямая</button>
              <button type="button" data-lay="corner" aria-pressed="false"><svg viewBox="0 0 64 44" aria-hidden="true"><path class="wl" d="M4 5h56"/><path class="wl" d="M4 5v34"/><path class="m" d="M8 9h50v11H19v19H8z"/></svg> Угловая</button>
              <button type="button" data-lay="island" aria-pressed="false"><svg viewBox="0 0 64 44" aria-hidden="true"><path class="wl" d="M4 5h56"/><rect class="m" x="6" y="9" width="52" height="11"/><rect class="m" x="17" y="28" width="30" height="11"/></svg> С островом</button>
            </div>
          </fieldset>
          <fieldset><legend>Отделка фасадов и корпуса</legend>
            <div class="k-fin">
              <button type="button" data-fin="oak" aria-pressed="false"><Ph name="k7-sw-oak" tag="i" class="sw" alt="" sizes="120px" />Светлый дуб</button>
              <button type="button" data-fin="walnut" aria-pressed="true"><Ph name="k7-sw-walnut" tag="i" class="sw" alt="" sizes="120px" />Орех натуральный</button>
              <button type="button" data-fin="ivory" aria-pressed="false"><Ph name="k7-sw-ivory" tag="i" class="sw" alt="" sizes="120px" />Слоновая кость</button>
              <button type="button" data-fin="graphite" aria-pressed="false"><Ph name="k7-sw-graphite" tag="i" class="sw" alt="" sizes="120px" />Графит</button>
            </div>
          </fieldset>
          <div class="k-cta">
            <a class="v-btn v-btn--s" data-k3-cta href={createLink(base, 'kitchen', 'straight', 'walnut')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg> Создать самому в 3D</a>
            <p><b>Демо-версия</b>, без регистрации. Размеры задаются в миллиметрах. Сейчас проект из конструктора менеджеру не передаётся — для расчёта оставьте заявку.<span class="t-m"> Здесь показаны готовые рендеры демо-версии FORMIQ (3 планировки × 4 отделки); вращать сцену и менять размеры можно в самом конструкторе.</span></p>
          </div>
        </div>
      </div>
      <figure class="k-stage">
        <span class="k-arch" aria-hidden="true"></span>
        <div class="k-niche">

          <div class="k-view" data-kview role="img" aria-label="Рендер кухни из демо-версии конструктора FORMIQ">
          <Ph name="r7-straight-oak" class="r" alt="" sizes="(max-width: 600px) 100vw, 62vw" data-r="straight-oak" />
<Ph name="r7-straight-walnut" class="r on" alt="" sizes="(max-width: 600px) 100vw, 62vw" data-r="straight-walnut" />
<Ph name="r7-straight-ivory" class="r" alt="" sizes="(max-width: 600px) 100vw, 62vw" data-r="straight-ivory" />
<Ph name="r7-straight-graphite" class="r" alt="" sizes="(max-width: 600px) 100vw, 62vw" data-r="straight-graphite" />
<Ph name="r7-corner-oak" class="r" alt="" sizes="(max-width: 600px) 100vw, 62vw" data-r="corner-oak" />
<Ph name="r7-corner-walnut" class="r" alt="" sizes="(max-width: 600px) 100vw, 62vw" data-r="corner-walnut" />
<Ph name="r7-corner-ivory" class="r" alt="" sizes="(max-width: 600px) 100vw, 62vw" data-r="corner-ivory" />
<Ph name="r7-corner-graphite" class="r" alt="" sizes="(max-width: 600px) 100vw, 62vw" data-r="corner-graphite" />

---
import Ph from './Ph.astro';
import { CONTACTS, waLink } from '../../data/site';
import { createLink, CATEGORY_LINKS } from '../../data/create3d';
const base = import.meta.env.BASE_URL;
const wa = waLink('Здравствуйте! Хочу рассчитать мебель на заказ.');
---
<div class="x-bar" aria-hidden="true"><a class="p" href={base + '#contact'}>Рассчитать стоимость</a><a class="s" href={base + 'create-3d/'} aria-label="Создать в 3D, демо-версия"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg> 3D</a><a class="w" href={wa} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.6 19.4l1.1-3.4a8 8 0 1 1 3 2.8z"/><path d="M9.3 8.6c.2 2.6 3.4 5.8 6 6l1.1-1.4-1.9-1-1 .8a5 5 0 0 1-2.5-2.5l.8-1-1-1.9z"/></svg></a></div>
<div class="x-menu" id="x-menu" role="dialog" aria-modal="true" aria-label="Меню" hidden>
  <div class="x-menu-top"><span class="v-logo" role="img" aria-label="VERNISSAGE"></span><button class="x-menu-x" type="button" aria-label="Закрыть меню"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
  <nav aria-label="Меню разделов"><a href={base + '#works'}>Работы</a><a href={base + '#cats'}>Изготовление</a><a href={base + 'create-3d/'}>3D-конструктор</a><a href={base + '#how'}>Как заказать</a><a href={base + '#contact'}>Контакты</a></nav>
  <div class="x-menu-foot"><a class="v-btn v-btn--p" href={base + '#contact'}>Рассчитать стоимость</a><a class="v-btn v-btn--s" href={base + 'create-3d/'}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg> Создать самому в 3D</a><a class="x-menu-tel" href={CONTACTS.phoneHref}>+7 747 561 3005</a></div>
</div>

---
// Концепция B «Лента комнат»: первый экран — это сразу каталог. Короткий заголовок сверху, под ним — горизонтальная
// лента арок-комнат на всю ширину (первая — видео), следующая выглядывает справа. Листание — родной scroll-snap.
import LabHead from './LabHead.astro';
import Ph from '../v9/Ph.astro';
import { createLink, CATEGORY_LINKS } from '../../data/create3d';
const base = import.meta.env.BASE_URL;
const v = `${base}lab/hero-a`;
const rooms: [string, string, string][] = [
  ['Шкафы и гардеробные', 'w8-niche', 'Ниша и стеллаж с подсветкой'],
  ['Гостиные', 'w8-living-t', 'ТВ-зона и стеновые панели'],
  ['Спальни', 'w8-bed', 'Шкафы и световые линии'],
  ['Ванные', 'w8-bath', 'Подвесная тумба и зеркало'],
  ['Кабинеты', 'w8-study-t', 'Встроенный стеллаж'],
];
---
<section class="lbx lab-m" data-lab="b" aria-labelledby="lbx-h">
  <LabHead />
  <div class="lbx-top" data-lab-text>
    <p class="lbx-eb"><span>Мебель на заказ · Астана</span><span class="lbx-dots" aria-hidden="true">{[0, 1, 2, 3, 4, 5].map((i) => <i class={i === 0 ? 'on' : ''}></i>)}</span></p>
    <h1 class="lbx-h" id="lbx-h">Мебель для каждой комнаты — <em>по вашим размерам</em></h1>
  </div>
  <div class="lbx-rail" data-lab-rail aria-label="Комнаты: листайте вбок">
    <a class="lbx-card on" href={createLink(base, CATEGORY_LINKS['Кухни'])}>
      <span class="lbx-f"><video class="lab-vid" muted playsinline loop preload="metadata" poster={`${v}.webp`} aria-hidden="true" data-lab-video>
        <source src={`${v}.mp4`} type="video/mp4" /><source src={`${v}.webm`} type="video/webm" /></video></span>
      <span class="lbx-n">Кухни</span><span class="lbx-c">Кухня-столовая со светом</span>
    </a>
    {rooms.map(([name, ph, cap]) => (
      <a class="lbx-card" href={createLink(base, CATEGORY_LINKS[name as keyof typeof CATEGORY_LINKS])}>
        <span class="lbx-f"><Ph name={ph} tag="span" class="ph" alt="" sizes="74vw" /></span>
        <span class="lbx-n">{name}</span><span class="lbx-c">{cap}</span>
      </a>
    ))}
  </div>
  <div class="lbx-foot">
    <div class="lab-acts" data-hero-acts>
      <a class="lb lb--p" href={base + '#contact'}>Рассчитать стоимость<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></a>
      <a class="lb lb--g" href={base + 'create-3d/'}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>3D</a>
    </div>
  </div>
</section>

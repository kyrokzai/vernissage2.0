---
// Концепция C «Вечерняя сцена»: полноэкранное видео, вечерний свет, светлый текст внизу. Первый экран «прилипает»,
// а следующий раздел наезжает на него слоем со скруглением — кинематографическая смена сцены без перехвата прокрутки.
import LabHead from './LabHead.astro';
const base = import.meta.env.BASE_URL;
const v = `${base}lab/hero-c`;
---
<section class="lc lab-m" data-lab="c" aria-labelledby="lc-h">
  <div class="lc-stage" data-lab-frame>
    <video class="lab-vid" muted playsinline loop preload="metadata" poster={`${v}.webp`} aria-hidden="true" data-lab-video>
      <source src={`${v}.mp4`} type="video/mp4" />
      <source src={`${v}.webm`} type="video/webm" />
    </video>
    <span class="lc-shade" aria-hidden="true" data-lab-shade></span>
    <img class="lc-fg" src={`${base}cine/branch-fg.webp`} alt="" aria-hidden="true" decoding="async" data-lab-fg />
  </div>
  <LabHead tone="ivory" />
  <div class="lc-txt" data-lab-text>
    <p class="lc-eb">Мебельная компания · Астана · с 2003 года</p>
    <h1 class="lc-h" id="lc-h"><span class="lw"><span>Мебель по&nbsp;вашим</span></span> <span class="lw"><span>размерам.</span></span> <span class="lw"><em>Создайте её сами.</em></span></h1>
    <div class="lab-acts" data-hero-acts>
      <a class="lb lb--i" href={base + '#contact'}>Рассчитать стоимость</a>
      <a class="lb lb--gi" href={base + 'create-3d/'}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>3D</a>
    </div>
    <p class="lc-cap">Реальный проект VERNISSAGE · вечерний свет</p>
  </div>
  <span class="lc-cue" aria-hidden="true"></span>
</section>

---
/**
 * Авторский блок VERNISSAGE «От детали — к целому».
 * Прокрутка ведёт камеру: макро материала → детали производства → готовый интерьер (видео) → знак VERNISSAGE.
 * При prefers-reduced-motion и без JavaScript показывается статичная раскладка из четырёх глав.
 */
import { DETAIL_TO_WHOLE as CH } from '../data/site';
import { img, ph } from '../data/media';
import { getImage } from 'astro:assets';

const base = import.meta.env.BASE_URL;
const film = CH[2].shots[0];
const posterLand = await getImage({ src: img(film.img).meta, width: 1600, format: 'webp', quality: 70 });
const posterPort = await getImage({ src: img(film.portImg).meta, width: 900, format: 'webp', quality: 70 });
const shots = CH.flatMap((c) => c.shots.filter((s) => !('video' in s)));
// размытый фон кадра: крошечная копия фото, растянутая браузером, — вместо дорогого filter: blur()
const soft = await Promise.all(shots.map((s) => getImage({ src: img(s.img).meta, width: 40, format: 'webp', quality: 60 })));
---
<section class="dw" id="detail" aria-labelledby="dw-h">
  <div class="dw-pin">
    <div class="dw-stage" aria-hidden="true">
      {shots.map((s, i) => <div class="dw-shot" data-s={i}><span class="dw-bg" style={`background-image:url("${soft[i].src}")`}></span><span class="dw-win"><span class={`dw-in ${ph(s.img)}`}></span></span></div>)}
      <span class="dw-win dw-probe"></span>
      <div class="dw-shot dw-film" data-s="film">
        {/* раскрытие «окна»: внешний слой масштабируется, внутренний — обратно (только transform) */}
        <div class="dw-film-in"><div class="dw-film-z">
          <span class={`${ph(film.img)} dw-film-ph`}></span>
          <video class="dw-video" muted playsinline loop preload="none" disablepictureinpicture
            data-land={`${base}media/video/${film.video.land}`} data-port={`${base}media/video/${film.video.port}`}
            data-poster-land={posterLand.src} data-poster-port={posterPort.src}></video>
          <span class="dw-dim"></span>
        </div></div>
      </div>
      <div class="dw-final">
        <span class="dw-glow"></span>
        <span class="dw-logo"></span>
      </div>
      <div class="dw-shade"></div>
    </div>

    <div class="wrap dw-ui">
      <div class="dw-head">
        <p class="label">От детали к целому</p>
        <h2 id="dw-h">Почерк VERNISSAGE&nbsp;— <span class="gt">в каждой детали</span></h2>
      </div>
      <ol class="dw-ch">
        {CH.map((c, i) => (
          <li class={i === 0 ? 'on' : undefined}>
            {c.shots[0] ? <span class={`dw-ch-img ${ph(c.shots[0].img)}`} aria-hidden="true"></span> : <span class="dw-ch-img dw-ch-logo" aria-hidden="true"></span>}
            <span class="dw-n">{c.n}<i></i>{c.label}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            {i === CH.length - 1 && <a class="btn btn-primary" href="#quiz">Рассчитать мой проект</a>}
          </li>
        ))}
      </ol>
      <div class="dw-rail" aria-hidden="true">
        {CH.map((c) => <span><b>{c.n}</b></span>)}
        <i class="dw-rail-p"></i>
      </div>
    </div>
  </div>
</section>
<script>
  import { initDetailToWhole } from '../scripts/detail';
  initDetailToWhole();
</script>

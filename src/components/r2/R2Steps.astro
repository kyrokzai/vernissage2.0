---
// «Как заказать»: три шага одной строкой (без закрепления), сразу за ними — заявка, WhatsApp и контакты (Lead).
const steps: [string, string][] = [
  ['Заявка', 'Оставьте телефон или напишите в WhatsApp. Можно приложить идею из 3D-конструктора.'],
  ['Бесплатный замер', 'Приезжаем на объект и снимаем точные размеры.'],
  ['Проект и изготовление', 'Фиксируем проект, стоимость и сроки в договоре, изготавливаем и устанавливаем мебель.'],
];
---
<section class="sp2" id="how" aria-labelledby="sp2-h">
  <div class="r2-wrap">
    <div class="sp2-head">
      <p class="r2-eb">Процесс</p>
      <h2 class="r2-h2" id="sp2-h">Как заказать</h2>
      <p class="r2-lead">Стоимость считает менеджер после бесплатного замера. Автоматических цен на&nbsp;сайте нет.</p>
    </div>
    <ol class="sp2-list">
      {steps.map(([t, d], i) => <li><span class="sp2-n">{i + 1}</span><h3 class="sp2-t">{t}</h3><p class="sp2-d">{d}</p></li>)}
    </ol>
  </div>
</section>

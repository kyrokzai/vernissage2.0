---
// «Что мы создаём»: категории для дома и бизнеса одной лентой арок (телефон — горизонтальная лента, компьютер — сетка 4×2).
// Комнаты открывают 3D-конструктор с этой комнатой, коммерческие категории ведут к заявке.
import Pic from './Pic.astro';
import { createLink, CATEGORY_LINKS } from '../../data/create3d';
const base = import.meta.env.BASE_URL;
const items: [string, string, string, string, string][] = [
  ['Кухни', 'Фасады, пеналы, подсветка', 'w8-kitchen', 'Кухня со светлыми фасадами и подсветкой', ''],
  ['Шкафы и гардеробные', 'Ниши, стеллажи, свет внутри', 'w8-niche', 'Ниша со стеллажом и подсветкой', ''],
  ['Гостиные', 'ТВ-зоны и стеновые панели', 'w8-living-t', 'Гостиная с ТВ-зоной и стеновыми панелями', ''],
  ['Спальни', 'Шкафы и световые линии', 'w8-bed', 'Спальня со шкафами и световыми линиями', ''],
  ['Ванные', 'Подвесные тумбы и зеркала', 'w8-bath', 'Подвесная тумба и зеркало в ванной', ''],
  ['Кабинеты', 'Встроенные стеллажи', 'w8-study-t', 'Кабинет со встроенным стеллажом', ''],
  ['Рестораны', 'Мягкие зоны, перегородки, декор', 'rest-dark', 'Зал ресторана с мягкими зонами, арками и подвесным светом', '#contact'],
  ['Магазины и бутики', 'Входные группы и витрины', 'jac-2975', 'Витрина детского бутика Jacadi Paris с подиумом', '#contact'],
];
---
<section class="cr2" id="cats" aria-labelledby="cr2-h">
  <div class="r2-wrap cr2-head">
    <p class="r2-eb">Что мы создаём</p>
    <h2 class="r2-h2" id="cr2-h">Мебель для дома и&nbsp;бизнеса</h2>
    <p class="r2-lead">Выберите комнату — откроется 3D-конструктор с&nbsp;ней. Для ресторанов и&nbsp;магазинов делаем мебель и&nbsp;отделку по&nbsp;фирменному стилю.</p>
  </div>
  <ul class="r2-wrap cr2-list">
    {items.map(([name, note, ph, alt, href], i) => (
      <li class:list={{ biz: !!href }}>
        <a class="cr2-it" href={href || createLink(base, CATEGORY_LINKS[name as keyof typeof CATEGORY_LINKS])}>
          <span class="cr2-th"><Pic src={ph} alt={alt} sizes="(max-width: 760px) 46vw, 24vw" /></span>
          <span class="cr2-n">{name}</span>
          <span class="cr2-note">{note}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

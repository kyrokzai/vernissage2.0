---
// Указатель комнат вместо карточек: крупные названия, у каждого — реальное фото. Строка ведёт в 3D-конструктор с этой комнатой.
// Компьютер: при наведении фото комнаты появляется справа и следует за курсором по вертикали. Телефон: миниатюра-арка в строке.
import Pic from './Pic.astro';
import { createLink, CATEGORY_LINKS } from '../../data/create3d';
const base = import.meta.env.BASE_URL;
const rooms: [string, string, string, string][] = [
  ['Кухни', 'Фасады, пеналы, подсветка', 'w8-kitchen', 'Кухня со светлыми фасадами и подсветкой'],
  ['Шкафы и гардеробные', 'Ниши, стеллажи, свет внутри', 'w8-niche', 'Ниша со стеллажом и подсветкой'],
  ['Гостиные', 'ТВ-зоны и стеновые панели', 'w8-living-t', 'Гостиная с ТВ-зоной и стеновыми панелями'],
  ['Спальни', 'Шкафы и световые линии', 'w8-bed', 'Спальня со шкафами и световыми линиями'],
  ['Ванные', 'Подвесные тумбы и зеркала', 'w8-bath', 'Подвесная тумба и зеркало в ванной'],
  ['Кабинеты', 'Встроенные стеллажи', 'w8-study-t', 'Кабинет со встроенным стеллажом'],
];
---
<section class="rm2" id="cats" aria-labelledby="rm2-h">
  <div class="r2-wrap rm2-grid">
    <div class="rm2-head">
      <h2 class="r2-h2" id="rm2-h">Мебель для каждой комнаты</h2>
      <p class="r2-lead">Нажмите на комнату, чтобы собрать её в&nbsp;3D и прислать нам свои размеры.</p>
    </div>
    <ol class="rm2-list">
      {rooms.map(([name, note, ph, alt], i) => (
        <li>
          <a class="rm2-row" href={createLink(base, CATEGORY_LINKS[name as keyof typeof CATEGORY_LINKS])} data-i={i}>
            <span class="rm2-n">{name}</span>
            <span class="rm2-note">{note}</span>
            <span class="rm2-th"><Pic src={ph} alt={alt} sizes="(max-width: 760px) 96px, 1px" /></span>
            <svg class="rm2-ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
          </a>
        </li>
      ))}
    </ol>
    <div class="rm2-peek" aria-hidden="true" data-r2-peek>
      {rooms.map(([, , ph], i) => <div class="rm2-pk" data-i={i}><Pic src={ph} alt="" sizes="(max-width: 760px) 1px, 34vw" /></div>)}
    </div>
  </div>
</section>

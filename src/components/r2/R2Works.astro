---
// «Реализованные проекты»: проект «Квартира под ключ», материалы и детали — одна галерея (бенто) на тёмной полосе.
// Фото раскрываются из маски, внутри рамок — лёгкий параллакс (r2.ts).
import Pic from './Pic.astro';
const base = import.meta.env.BASE_URL;
const small: [string, string, number][] = [
  ['res-1684', 'Угловая кухня со светлыми фасадами и подсветкой', -5],
  ['mat-niche-light', 'Ниша со стеллажом и подсветкой в спальне', 6],
  ['mat-facades', 'Светлые фасады без ручек со световой линией', -6],
  ['mat-parquet', 'Паркет ёлочкой из светлого дуба', 7],
  ['mat-upholstery-white', 'Кресло в белой обивке букле', 5],
  ['mat-carved-screens', 'Резные перегородки с подсветкой', -5],
];
---
<section class="wk2 r2-dark" id="works" aria-labelledby="wk2-h">
  <div class="r2-wrap wk2-head">
    <p class="r2-eb">Реализованные проекты</p>
    <h2 class="r2-h2" id="wk2-h">Квартира под ключ</h2>
    <div class="wk2-side">
      <p class="r2-lead">Мебель для каждой комнаты вместе с&nbsp;дизайн-проектом и&nbsp;ремонтом. Фасады без ручек, световые линии, натуральный шпон и&nbsp;мягкая обивка.</p>
      <a class="r2-link" href={base + 'portfolio/residential/'}>Открыть проект<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
  <div class="r2-wrap wk2-g">
    <figure class="wk2-big" data-r2-depth="-4"><span class="pj2-tag">Астана · кухня-гостиная</span><Pic src="res-wide" alt="Кухня-гостиная со встроенными шкафами, световыми линиями и обеденной зоной" sizes="(max-width: 760px) 92vw, 64vw" /></figure>
    {small.map(([src, alt, d]) => <figure data-r2-depth={d}><Pic src={src} alt={alt} sizes="(max-width: 760px) 46vw, 22vw" /></figure>)}
  </div>
</section>

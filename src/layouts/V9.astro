---
// Страницы в утверждённом светлом дизайне v9. Своя тема (светлая), свои шрифты; тёмный global.css не подключается.
import '../styles/v9.css';
import '../styles/i18n.css';
import { PAGES } from '../i18n/pages.mjs';
import favicon from '../assets/logo/mark.svg';
import fCorCyr from '../assets/fonts/cormorant-cyr-500-normal.woff2?url';
import fManCyr from '../assets/fonts/manrope-cyr.woff2?url';

interface Props { title: string; description: string; path: string; pageClass?: string; noindex?: boolean }
const { title, description, path, pageClass, noindex } = Astro.props;
const canonical = new URL(import.meta.env.BASE_URL + path, Astro.site).href;
---
<!doctype html>
<html lang="ru" data-theme="light" class={pageClass}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F6F1E8" />
  <meta name="format-detection" content="telephone=no" />
  {/* тестовые адреса на Vercel (*.vercel.app) не индексируются: PUBLIC_VN_NOINDEX задаёт astro.config.mjs; доступ по ссылке свободный */}
  {(noindex || import.meta.env.PUBLIC_VN_NOINDEX === '1') && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  {[fCorCyr, fManCyr].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <link rel="icon" type="image/svg+xml" href={favicon.src} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {PAGES.includes(path) && [['ru', ''], ['kk', 'kk/'], ['x-default', '']].map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(import.meta.env.BASE_URL + p + path, Astro.site).href} />)}
  <script is:inline>(function(){try{var d=document.documentElement;if(localStorage.getItem('vn-lang')==='kk'&&d.lang==='ru'){var l=document.querySelector('link[hreflang=kk]');if(l){location.replace(new URL(l.href).pathname+location.search+location.hash);return}}var y=sessionStorage.getItem('vn-lang-y');if(y!==null){sessionStorage.removeItem('vn-lang-y');history.scrollRestoration='manual';addEventListener('load',function(){scrollTo(0,+y)})}}catch(e){}})()</script>
  <style is:global>::view-transition-group(k3){animation-duration:.62s;animation-timing-function:cubic-bezier(.2,.7,.2,1)}@media (prefers-reduced-motion: reduce){::view-transition-group(*),::view-transition-old(*),::view-transition-new(*){animation:none!important}}</style>
</head>
<body>
  <slot />
</body>
</html>
